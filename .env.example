GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# clé de signature des JWT — générer une valeur aléatoire longue, jamais la valeur ci-dessous
JWT_SECRET=

# false en local (http), true en production (https obligatoire pour les cookies Secure)
COOKIE_SECURE=true

# liste blanche d'origines autorisées pour le dashboard, séparées par des virgules — jamais "*"
CORS_ORIGINS=

# compte admin créé une seule fois par seed.py si ces deux variables sont définies
# (aucun autre moyen de créer un compte admin : jamais via une route web)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# clé Fernet pour chiffrer les refresh tokens Google Calendar en base — générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# OAuth Client ID "Web application" créé dans Google Cloud Console (différent du
# compte de service utilisé pour le salon de démo) — voir PRIVACY.md pour l'écran de consentement
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
